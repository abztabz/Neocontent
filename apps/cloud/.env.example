SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: required only for explicitly enabled cloud_api sites.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_RESEARCH_MODEL=gpt-5-mini
NEO_SECRET_ENCRYPTION_KEY=
CRON_SECRET=
NEO_REGISTRATION_TOKEN=
NEO_OPERATOR_TOKEN=
# Free-first SERP intelligence is fail-closed. Enable only after adding at least one reviewed provider key.
NEO_ENABLE_EXPERIMENTAL_SEO=false
NEO_SERPAPI_KEY=
NEO_ZENSERP_KEY=
# Web Push keys are generated as a pair. The private key remains Vercel-only.
NEO_VAPID_SUBJECT=mailto:operator@example.com
NEO_VAPID_PUBLIC_KEY=
NEO_VAPID_PRIVATE_KEY=
NEO_MAX_MANUAL_RUNS_PER_HOUR=3
